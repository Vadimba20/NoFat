import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Tabs, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Camera } from "lucide-react";
import { useState, useRef, useEffect } from "react";
import { initializeApp } from "firebase/app";
import { getFirestore, collection, addDoc, getDocs, query, where, doc, setDoc, getDoc } from "firebase/firestore";
import { getAuth, signInAnonymously, onAuthStateChanged } from "firebase/auth";
import {
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
} from "recharts";

const firebaseConfig = {
  apiKey: "YOUR_API_KEY",
  authDomain: "YOUR_AUTH_DOMAIN",
  projectId: "YOUR_PROJECT_ID",
  storageBucket: "YOUR_STORAGE_BUCKET",
  messagingSenderId: "YOUR_MESSAGING_SENDER_ID",
  appId: "YOUR_APP_ID"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);
const auth = getAuth(app);

export default function NutriSnapApp() {
  const [photo, setPhoto] = useState(null);
  const [foodData, setFoodData] = useState(null);
  const [diary, setDiary] = useState([]);
  const [user, setUser] = useState(null);
  const [goal, setGoal] = useState(2000);
  const [goalInput, setGoalInput] = useState("");
  const fileInputRef = useRef();

  useEffect(() => {
    signInAnonymously(auth).catch(console.error);
    onAuthStateChanged(auth, (firebaseUser) => {
      if (firebaseUser) setUser(firebaseUser);
    });
  }, []);

  useEffect(() => {
    if (!user) return;
    const loadDiary = async () => {
      const q = query(collection(db, "foodDiary"), where("uid", "==", user.uid));
      const querySnapshot = await getDocs(q);
      const items = querySnapshot.docs.map(doc => doc.data());
      setDiary(items);
    };
    const loadGoal = async () => {
      const goalDoc = await getDoc(doc(db, "goals", user.uid));
      if (goalDoc.exists()) setGoal(goalDoc.data().calories);
    };
    loadDiary();
    loadGoal();
  }, [user]);

  const saveGoal = async () => {
    const value = parseInt(goalInput);
    if (!user || isNaN(value)) return;
    await setDoc(doc(db, "goals", user.uid), { calories: value });
    setGoal(value);
    setGoalInput("");
  };

  const handlePhotoUpload = async (e) => {
    const file = e.target.files[0];
    if (!file || !user) return;
    setPhoto(file);

    const response = await fetch("https://api-inference.huggingface.co/models/roboflow/food-vision", {
      method: "POST",
      headers: {
        Authorization: `Bearer YOUR_HUGGINGFACE_TOKEN`,
        "Content-Type": "application/octet-stream",
      },
      body: file,
    });
    const result = await response.json();

    const analysis = {
      calories: Math.floor(Math.random() * 400 + 200),
      protein: Math.floor(Math.random() * 30 + 10),
      fat: Math.floor(Math.random() * 20 + 5),
      carbs: Math.floor(Math.random() * 60 + 20),
    };

    setFoodData(analysis);

    await addDoc(collection(db, "foodDiary"), {
      name: result?.predicted_class || "Неизвестное блюдо",
      ...analysis,
      timestamp: new Date(),
      uid: user.uid
    });
  };

  const handleOpenFileDialog = () => {
    fileInputRef.current.click();
  };

  const chartData = diary.reduce((acc, entry) => {
    const date = new Date(entry.timestamp.seconds * 1000).toLocaleDateString();
    const existing = acc.find(i => i.date === date);
    if (existing) {
      existing.calories += entry.calories;
    } else {
      acc.push({ date, calories: entry.calories });
    }
    return acc;
  }, []);

  const todayCalories = diary.reduce((sum, item) => sum + item.calories, 0);
  const goalReached = todayCalories >= goal;

  return (
    <div className="p-4 space-y-6">
      <h1 className="text-2xl font-bold text-center">NutriSnap</h1>

      <Tabs defaultValue="photo" className="w-full">
        <TabsList className="grid grid-cols-2">
          <TabsTrigger value="photo">Фото</TabsTrigger>
          <TabsTrigger value="manual">Ручной ввод</TabsTrigger>
        </TabsList>

        {/* Фотоанализ */}
        <div className="mt-4">
          <Card className="rounded-2xl shadow-md p-4">
            <CardContent className="space-y-4">
              <input
                ref={fileInputRef}
                type="file"
                accept="image/*"
                capture="environment"
                className="hidden"
                onChange={handlePhotoUpload}
              />
              <Button className="w-full" variant="outline" onClick={handleOpenFileDialog}>
                <Camera className="mr-2 h-5 w-5" /> Сфотографировать еду
              </Button>
              {photo && (
                <img src={URL.createObjectURL(photo)} alt="Food" className="rounded-xl" />
              )}
              {foodData && (
                <div className="space-y-2">
                  <h2 className="text-xl font-semibold">Результат анализа</h2>
                  <p>Калории: {foodData.calories} ккал</p>
                  <p>Белки: {foodData.protein} г</p>
                  <p>Жиры: {foodData.fat} г</p>
                  <p>Углеводы: {foodData.carbs} г</p>
                </div>
              )}
            </CardContent>
          </Card>
        </div>

        {/* Ручной ввод */}
        <div className="mt-4">
          <Card className="rounded-2xl shadow-md p-4">
            <CardContent className="space-y-2">
              <Input placeholder="Название блюда" />
              <div className="grid grid-cols-2 gap-2">
                <Input placeholder="Калории (ккал)" type="number" />
                <Input placeholder="Белки (г)" type="number" />
                <Input placeholder="Жиры (г)" type="number" />
                <Input placeholder="Углеводы (г)" type="number" />
              </div>
              <Button className="w-full">Сохранить</Button>
            </CardContent>
          </Card>
        </div>
      </Tabs>

      {/* Цель и прогресс */}
      <div>
        <h2 className="text-xl font-semibold mt-6 mb-2">🎯 Цель по калориям</h2>
        <Card className="rounded-2xl shadow-md p-4">
          <CardContent className="space-y-2">
            <p>Текущая цель: {goal} ккал</p>
            <Input
              type="number"
              placeholder="Установить новую цель (ккал)"
              value={goalInput}
              onChange={(e) => setGoalInput(e.target.value)}
            />
            <Button onClick={saveGoal}>Сохранить цель</Button>
            <p className={goalReached ? "text-green-600 font-medium" : "text-red-500 font-medium"}>
              {goalReached ? "Цель достигнута!" : `Осталось: ${goal - todayCalories} ккал`}
            </p>
          </CardContent>
        </Card>
      </div>

      {/* Дневник питания */}
      <div>
        <h2 className="text-xl font-semibold mt-6 mb-2">📘 Дневник питания</h2>
        <Card className="rounded-2xl shadow-md p-4">
          <CardContent className="space-y-2">
            {diary.map((item, index) => (
              <p key={index}>🍽 {item.name}: {item.calories} ккал</p>
            ))}
            <hr className="my-2" />
            <p className="font-medium">
              Итого за день: {todayCalories} ккал
            </p>
          </CardContent>
        </Card>
      </div>

      {/* График калорий */}
      <div>
        <h2 className="text-xl font-semibold mt-6 mb-2">📈 Калории по дням</h2>
        <Card className="rounded-2xl shadow-md p-4">
          <CardContent>
            <ResponsiveContainer width="100%" height={250}>
              <LineChart data={chartData}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="date" />
                <YAxis />
                <Tooltip />
                <Line type="monotone" dataKey="calories" stroke="#8884d8" strokeWidth={2} />
              </LineChart>
            </ResponsiveContainer>
          </CardContent>
        </Card>
      </div>
    </div>
  );
}
